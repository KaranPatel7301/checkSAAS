<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.karan.saasscout</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/karanpatel/checkSAAS/checkSAAS/.venv/bin/python</string>
        <string>/Users/karanpatel/checkSAAS/checkSAAS/saas_scout.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/karanpatel/checkSAAS/checkSAAS</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>SAAS_SCOUT_SEEN</key>
        <string>/Users/karanpatel/checkSAAS/checkSAAS/seen.json</string>
    </dict>

    <!-- Runs at 8am, 1pm, and 7pm local time each day (when the Mac is awake). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/karanpatel/checkSAAS/checkSAAS/scout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/karanpatel/checkSAAS/checkSAAS/scout.log</string>
</dict>
</plist>
